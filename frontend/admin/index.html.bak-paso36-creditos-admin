<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Slot Engine Panel</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
body{margin:0;font-family:Arial;background:#f4f6fb;color:#111}
header{background:#111827;color:white;padding:16px;text-align:center}
.container{max-width:1200px;margin:auto;padding:20px}
.card{background:white;border-radius:16px;padding:20px;margin:15px 0;box-shadow:0 8px 25px #0001}
input,select,button{padding:12px;margin:6px 0;border-radius:10px;border:1px solid #ccc;width:100%;box-sizing:border-box}
button{background:#2563eb;color:white;border:0;font-weight:bold;cursor:pointer}
button:hover{background:#1d4ed8}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:15px}
.stat{background:#eef2ff;border-radius:14px;padding:15px}
.hidden{display:none}

.reels{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:12px;
margin-top:20px;
}

.spin-animation{
animation: spin .12s linear infinite;
}

.win-animation{
animation: winPulse 1s ease-in-out 3;
}

@keyframes spin{
0%{transform:translateY(-8px)}
50%{transform:translateY(8px)}
100%{transform:translateY(-8px)}
}

@keyframes winPulse{
0%{transform:scale(1);box-shadow:0 0 0 rgba(212,175,55,0)}
50%{transform:scale(1.08);box-shadow:0 0 25px rgba(212,175,55,.9)}
100%{transform:scale(1);box-shadow:0 0 0 rgba(212,175,55,0)}
}
.symbol{
background:linear-gradient(180deg,#1e293b,#0f172a);
border:2px solid #d4af37;
color:white;
font-size:0;
text-align:center;
padding:18px;
border-radius:14px;
box-shadow:0 0 12px rgba(212,175,55,.35);
min-height:72px;
display:flex;
align-items:center;
justify-content:center;
overflow:hidden;
}
.symbol img{width:100%;max-width:95px;height:auto;display:block;filter:drop-shadow(0 0 8px rgba(212,175,55,.55));}

.reels{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:10px;
background:linear-gradient(180deg,#1f2937,#111827);
padding:15px;
border-radius:18px;
border:3px solid #d4af37;
}

body{
background:
linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.7)),
url('/assets/background.svg');
background-size:cover;
background-attachment:fixed;
}

.card{
background:rgba(255,255,255,.95);
}

pre{background:#111827;color:#e5e7eb;padding:12px;border-radius:12px;overflow:auto}
</style>

<style id="legacy-nile-fix">
body{
background:
linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.75)),
url('/assets/background.svg') !important;
background-size:cover !important;
background-attachment:fixed !important;
}
.symbol{
background:linear-gradient(180deg,#1e293b,#0f172a) !important;
border:2px solid #d4af37 !important;
border-radius:14px !important;
min-height:88px !important;
display:flex !important;
align-items:center !important;
justify-content:center !important;
overflow:hidden !important;
padding:8px !important;
font-size:0 !important;
}
.symbol img{
width:100% !important;
max-width:96px !important;
height:auto !important;
display:block !important;
filter:drop-shadow(0 0 8px rgba(212,175,55,.6)) !important;
}
.reels{
display:grid !important;
grid-template-columns:repeat(5,1fr) !important;
gap:10px !important;
background:linear-gradient(180deg,#1f2937,#111827) !important;
padding:15px !important;
border-radius:18px !important;
border:3px solid #d4af37 !important;
}
</style>

</head>
<body>

<header>
<h1>Slot Engine</h1>
<p>Panel Superadmin / Motor</p>
</header>

<div class="container">

<div id="loginBox" class="card">
<h2>Ingresar</h2>
<input id="email" placeholder="Email">
<input id="password" placeholder="Contraseña" type="password">
<button onclick="login()">Ingresar</button>
<pre id="loginMsg"></pre>
</div>

<div id="panel" class="hidden">

<div class="card">
<h2>Dashboard Superadmin</h2>
<button onclick="loadDashboard()">Actualizar dashboard</button>
<div id="stats" class="grid"></div>
</div>

<div class="card">
<h2>Configuración del motor</h2>

<p style="color:#666;margin-bottom:20px">
Definí cómo se distribuye el dinero de cada apuesta. La suma de premios, bonus, multiplicadores y pozo debe ser exactamente 100%.
</p>

<div class="grid">

<div>
<label><strong>Ganancia fija de la casa (%)</strong></label>
<p style="font-size:12px;color:#666;margin:4px 0 8px">
Porcentaje reservado automáticamente para la casa en cada apuesta.
</p>
<input id="house_percentage" type="number" step="0.01">
</div>

<div>
<label><strong>Duración del pozo (días)</strong></label>
<p style="font-size:12px;color:#666;margin:4px 0 8px">
Tiempo que dura la etapa activa antes de cerrar y transferir el remanente a la casa.
</p>
<input id="pool_stage_days" type="number">
</div>

<div>
<label><strong>Premios pequeños (%)</strong></label>
<p style="font-size:12px;color:#666;margin:4px 0 8px">
Fondo destinado a premios frecuentes y de menor valor.
</p>
<input id="small_prize_percentage" type="number" step="0.01">
</div>

<div>
<label><strong>Premios medianos (%)</strong></label>
<p style="font-size:12px;color:#666;margin:4px 0 8px">
Fondo destinado a premios intermedios.
</p>
<input id="medium_prize_percentage" type="number" step="0.01">
</div>

<div>
<label><strong>Premios grandes (%)</strong></label>
<p style="font-size:12px;color:#666;margin:4px 0 8px">
Fondo destinado a premios altos.
</p>
<input id="big_prize_percentage" type="number" step="0.01">
</div>

<div>
<label><strong>Bonus (%)</strong></label>
<p style="font-size:12px;color:#666;margin:4px 0 8px">
Fondo destinado a giros gratis y eventos bonus.
</p>
<input id="bonus_percentage" type="number" step="0.01">
</div>

<div>
<label><strong>Multiplicadores (%)</strong></label>
<p style="font-size:12px;color:#666;margin:4px 0 8px">
Fondo destinado a multiplicadores de premios.
</p>
<input id="multiplier_percentage" type="number" step="0.01">
</div>

<div>
<label><strong>Pozo acumulativo (%)</strong></label>
<p style="font-size:12px;color:#666;margin:4px 0 8px">
Fondo reservado para el pozo de la etapa activa.
</p>
<input id="pool_percentage" type="number" step="0.01">
</div>

</div>

<div id="distributionStatus" style="
margin-top:20px;
padding:15px;
border-radius:12px;
background:#eef2ff;
font-weight:bold;">
Total distribución: 0%
</div>

<button onclick="saveConfig()" style="margin-top:20px">
Guardar configuración
</button>

<pre id="configMsg"></pre>

</div>

<div class="card">
<h2>Usuarios</h2>
<input id="newEmail" placeholder="Email nuevo usuario">
<input id="newPass" placeholder="Contraseña">
<select id="newRole">
<option value="user">Usuario final</option>
<option value="admin">Admin</option>
</select>
<button onclick="createUser()">Crear usuario</button>
<pre id="userMsg"></pre>
</div>


<div class="card">
<h2>Usuarios registrados</h2>
<button onclick="loadUsers()">Actualizar usuarios</button>
<div id="usersBox"></div>
</div>


<div class="card">
<h2>Retiros pendientes y revisados</h2>
<button onclick="loadWithdrawals()">Actualizar retiros</button>
<div id="withdrawalsBox"></div>
</div>

<div class="card">
<h2>Últimas jugadas</h2>
<button onclick="loadRounds()">Actualizar jugadas</button>
<div id="roundsBox"></div>
</div>

<div class="card">
<h2>Cargar saldo</h2>
<input id="balanceUserId" placeholder="ID usuario">
<input id="balanceAmount" placeholder="Monto">
<button onclick="addBalance()">Cargar saldo</button>
<pre id="balanceMsg"></pre>
</div>

<div class="card">
<h2>Simulación estadística</h2>
<input id="simSpins" value="1000" placeholder="Cantidad de giros">
<input id="simBet" value="1000" placeholder="Apuesta">
<select id="simVol">
<option value="medium">Volatilidad media</option>
<option value="low">Volatilidad baja</option>
<option value="high">Volatilidad alta</option>
</select>
<button onclick="simulate()">Simular</button>
<pre id="simMsg"></pre>
</div>

<div class="card">
<h2>Prueba de giro real</h2>
<p>Para probar como jugador, primero creá un usuario y cargale saldo. Luego entrá con ese usuario cerrando sesión.</p>
<input id="spinBet" value="1000" placeholder="Apuesta">
<button id="spinButton" onclick="spin()">🎰 GIRAR</button>
<div id="reels" class="reels"></div>
<pre id="spinMsg"></pre>
</div>

<div class="card">
<button onclick="closeStage()">Cerrar etapa del pozo ahora</button>
<pre id="closeMsg"></pre>
</div>

<div class="card">
<button onclick="logout()">Cerrar sesión</button>
</div>

</div>
</div>

<script>
const API = "/api";
let token = localStorage.getItem("token") || "";

function headers(){
 return {"Content-Type":"application/json","Authorization":"Bearer "+token};
}

async function login(){
 const email=document.getElementById("email").value;
 const password=document.getElementById("password").value;
 const r=await fetch(API+"/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email,password})});
 const j=await r.json();
 document.getElementById("loginMsg").textContent=JSON.stringify(j,null,2);
 if(j.token){
  token=j.token;
  localStorage.setItem("token",token);
  document.getElementById("loginBox").classList.add("hidden");
  document.getElementById("panel").classList.remove("hidden");
  loadDashboard(); loadUsers(); loadRounds(); loadWithdrawals();
 }
}

function logout(){
 localStorage.removeItem("token");
 location.reload();
}

async function loadDashboard(){
 const r=await fetch(API+"/superadmin/dashboard",{headers:headers()});
 const j=await r.json();

 if(j.error){
  document.getElementById("stats").innerHTML="<div class='stat'>Este usuario no es superadmin o la sesión venció.</div>";
  return;
 }

 const f=j.financial;
 document.getElementById("stats").innerHTML = `
 <div class="stat"><b>Total apostado</b><br>$${f.total_bets}</div>
 <div class="stat"><b>Casa reservada</b><br>$${f.house_locked}</div>
 <div class="stat"><b>Premios pagados</b><br>$${f.prizes_paid}</div>
 <div class="stat"><b>Fondos activos</b><br>$${j.active_funds_total}</div>
 <div class="stat"><b>RTP real</b><br>${f.real_rtp_percent}%</div>
 <div class="stat"><b>Giros</b><br>${f.total_spins}</div>
 `;

 const c=j.config;
 house_percentage.value=c.house_percentage;
 pool_stage_days.value=c.pool_stage_days;
 small_prize_percentage.value=c.small_prize_percentage;
 medium_prize_percentage.value=c.medium_prize_percentage;
 big_prize_percentage.value=c.big_prize_percentage;
 bonus_percentage.value=c.bonus_percentage;
 multiplier_percentage.value=c.multiplier_percentage;
 pool_percentage.value=c.pool_percentage;
}

async function saveConfig(){
 const body={
  house_percentage:Number(house_percentage.value),
  pool_stage_days:Number(pool_stage_days.value),
  small_prize_percentage:Number(small_prize_percentage.value),
  medium_prize_percentage:Number(medium_prize_percentage.value),
  big_prize_percentage:Number(big_prize_percentage.value),
  bonus_percentage:Number(bonus_percentage.value),
  multiplier_percentage:Number(multiplier_percentage.value),
  pool_percentage:Number(pool_percentage.value),
  maintenance_mode:false
 };
 const r=await fetch(API+"/superadmin/config",{method:"PUT",headers:headers(),body:JSON.stringify(body)});
 const j=await r.json();
 configMsg.textContent=JSON.stringify(j,null,2);
 loadDashboard(); loadUsers(); loadRounds(); loadWithdrawals();
}

async function createUser(){
 const body={email:newEmail.value,password:newPass.value,role:newRole.value};
 const r=await fetch(API+"/superadmin/create-user",{method:"POST",headers:headers(),body:JSON.stringify(body)});
 const j=await r.json();
 userMsg.textContent=JSON.stringify(j,null,2);
}

async function addBalance(){
 const body={user_id:Number(balanceUserId.value),amount:Number(balanceAmount.value)};
 const r=await fetch(API+"/superadmin/add-balance",{method:"POST",headers:headers(),body:JSON.stringify(body)});
 const j=await r.json();
 balanceMsg.textContent=JSON.stringify(j,null,2);
 loadDashboard(); loadUsers(); loadRounds(); loadWithdrawals();
}

async function simulate(){
 const body={spins:Number(simSpins.value),bet_amount:Number(simBet.value),volatility:simVol.value};
 const r=await fetch(API+"/superadmin/simulate",{method:"POST",headers:headers(),body:JSON.stringify(body)});
 const j=await r.json();
 simMsg.textContent=JSON.stringify(j,null,2);
}

async function spin(){

 const btn = document.getElementById("spinButton");
 btn.disabled = true;
 btn.textContent = "GIRANDO...";

 await animateReels();

 const body={bet_amount:Number(spinBet.value)};
 const r=await fetch(API+"/play/spin",{method:"POST",headers:headers(),body:JSON.stringify(body)});
 const j=await r.json();

 spinMsg.textContent=JSON.stringify(j,null,2);

 if(j.result && j.result.grid){

  reels.innerHTML="";

  for(let row=0;row<3;row++){
   for(let col=0;col<5;col++){
    
const egypt = {
A:"/assets/symbols/pharaoh.svg",
T:"/assets/symbols/anubis.svg",
G:"/assets/symbols/horus.svg",
C:"/assets/symbols/scarab.svg",
M:"/assets/symbols/vase.svg",
F:"/assets/symbols/scroll.svg",
B:"/assets/symbols/bonus.svg",
W:"/assets/symbols/wild.svg"
};

const s = j.result.grid[row][col];
reels.innerHTML += `<div class="symbol">${legacyImg(s)}</div>`;

   }
  }
 }

 if(j.prize_amount > 0){
   document.querySelectorAll(".symbol").forEach(el=>{
      el.classList.add("win-animation");
   });

   playTone(440,0.2);
   setTimeout(()=>playTone(660,0.25),150);
   setTimeout(()=>playTone(880,0.35),300);
 }

 btn.disabled = false;
 btn.textContent = "🎰 GIRAR";

 loadDashboard(); loadUsers(); loadRounds(); loadWithdrawals();
}

async function closeStage(){
 const r=await fetch(API+"/superadmin/close-stage-now",{method:"POST",headers:headers()});
 const j=await r.json();
 closeMsg.textContent=JSON.stringify(j,null,2);
 loadDashboard(); loadUsers(); loadRounds(); loadWithdrawals();
}



function playTone(freq,duration){
 try{
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();

  osc.connect(gain);
  gain.connect(ctx.destination);

  osc.frequency.value = freq;
  osc.type = "triangle";

  gain.gain.setValueAtTime(0.05, ctx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);

  osc.start();
  osc.stop(ctx.currentTime + duration);
 }catch(e){}
}

function randomEgyptSymbol(){
 const arr = [
"/assets/symbols/pharaoh.svg",
"/assets/symbols/anubis.svg",
"/assets/symbols/horus.svg",
"/assets/symbols/scarab.svg",
"/assets/symbols/vase.svg",
"/assets/symbols/scroll.svg",
"/assets/symbols/bonus.svg",
"/assets/symbols/wild.svg"
];
 return `<img src="${arr[Math.floor(Math.random()*arr.length)]}" alt="symbol">`;
}

async function animateReels(){
 reels.innerHTML = "";

 for(let i=0;i<15;i++){
   reels.innerHTML += '<div class="symbol spin-animation">'+randomEgyptSymbol()+'</div>';
 }

 playTone(220,0.2);

 return new Promise(resolve=>{
   setTimeout(resolve,1200);
 });
}



const LEGACY_SYMBOLS = {
 A:"/assets/symbols/pharaoh.svg",
 T:"/assets/symbols/anubis.svg",
 G:"/assets/symbols/horus.svg",
 C:"/assets/symbols/scarab.svg",
 M:"/assets/symbols/vase.svg",
 F:"/assets/symbols/scroll.svg",
 B:"/assets/symbols/bonus.svg",
 W:"/assets/symbols/wild.svg"
};

function legacyImg(code){
 const src = LEGACY_SYMBOLS[code] || LEGACY_SYMBOLS.F;
 return `<img src="${src}" alt="${code}">`;
}

function legacyRandomImg(){
 const keys = Object.keys(LEGACY_SYMBOLS);
 const k = keys[Math.floor(Math.random()*keys.length)];
 return legacyImg(k);
}

async function animateReels(){
 reels.innerHTML = "";
 for(let i=0;i<15;i++){
   reels.innerHTML += '<div class="symbol spin-animation">'+legacyRandomImg()+'</div>';
 }
 playTone(220,0.2);
 return new Promise(resolve=>setTimeout(resolve,1200));
}

if(token){
 document.getElementById("loginBox").classList.add("hidden");
 document.getElementById("panel").classList.remove("hidden");
 loadDashboard(); loadUsers(); loadRounds(); loadWithdrawals();
}

function updateDistributionStatus(){
 const total =
 Number(small_prize_percentage.value || 0) +
 Number(medium_prize_percentage.value || 0) +
 Number(big_prize_percentage.value || 0) +
 Number(bonus_percentage.value || 0) +
 Number(multiplier_percentage.value || 0) +
 Number(pool_percentage.value || 0);

 const box = document.getElementById("distributionStatus");

 box.innerHTML = "Total distribución: " + total.toFixed(2) + "%";

 if(total === 100){
   box.style.background = "#dcfce7";
   box.style.color = "#166534";
 }else{
   box.style.background = "#fee2e2";
   box.style.color = "#991b1b";
 }
}

setTimeout(() => {
 [
  small_prize_percentage,
  medium_prize_percentage,
  big_prize_percentage,
  bonus_percentage,
  multiplier_percentage,
  pool_percentage
 ].forEach(el => {
   el.addEventListener("input", updateDistributionStatus);
 });

 updateDistributionStatus();
}, 1000);


async function loadUsers(){
 const r=await fetch(API+"/admin/users",{headers:headers()});
 const j=await r.json();
 if(!j.users){usersBox.innerHTML="<p>No se pudieron cargar usuarios.</p>";return;}
 usersBox.innerHTML = j.users.map(u=>`
  <div style="background:#f8fafc;border:1px solid #ddd;border-radius:12px;padding:12px;margin:10px 0">
    <b>ID ${u.id}</b> - ${u.email}<br>
    Rol: ${u.role} | Saldo: <b>$${Number(u.balance).toFixed(2)}</b><br>
    <input id="amount_${u.id}" placeholder="Monto a cargar">
    <button onclick="quickAddBalance(${u.id})">Cargar saldo a este usuario</button>
  </div>
 `).join("");
}

async function quickAddBalance(userId){
 const amount = Number(document.getElementById("amount_"+userId).value);
 if(!amount || amount<=0){alert("Ingresá un monto válido");return;}
 const r=await fetch(API+"/superadmin/add-balance",{
  method:"POST",
  headers:headers(),
  body:JSON.stringify({user_id:userId,amount})
 });
 const j=await r.json();
 alert(j.ok ? "Saldo cargado" : (j.error || "Error"));
 loadUsers();
 loadDashboard(); loadUsers(); loadRounds(); loadWithdrawals();
}

async function loadRounds(){
 const r=await fetch(API+"/admin/recent-rounds",{headers:headers()});
 const j=await r.json();
 if(!j.rounds){roundsBox.innerHTML="<p>No se pudieron cargar jugadas.</p>";return;}
 roundsBox.innerHTML = j.rounds.map(x=>`
  <div style="background:#f8fafc;border:1px solid #ddd;border-radius:12px;padding:12px;margin:10px 0">
    <b>${x.email}</b><br>
    Apuesta: $${Number(x.bet_amount).toFixed(2)} |
    Premio: $${Number(x.prize_amount).toFixed(2)} |
    Tipo: ${x.prize_tier}<br>
    Saldo: $${Number(x.balance_before).toFixed(2)} → $${Number(x.balance_after).toFixed(2)}<br>
    <small>${x.created_at}</small>
  </div>
 `).join("");
}


async function loadWithdrawals(){
 const r = await fetch(API+"/admin/withdrawals",{headers:headers()});
 const j = await r.json();
 if(!j.withdrawals){withdrawalsBox.innerHTML="<p>No se pudieron cargar retiros.</p>";return;}

 withdrawalsBox.innerHTML = j.withdrawals.map(w=>`
  <div style="background:#f8fafc;border:1px solid #ddd;border-radius:12px;padding:12px;margin:10px 0">
    <b>${w.email}</b><br>
    Monto: <b>$${Number(w.amount).toFixed(2)}</b><br>
    Estado: <b>${w.status}</b><br>
    Fecha: <small>${w.created_at}</small><br>
    ${w.status==="pending" ? `
      <button onclick="approveWithdrawal(${w.id})">Aprobar</button>
      <button onclick="rejectWithdrawal(${w.id})" style="background:#dc2626">Rechazar</button>
    ` : ""}
  </div>
 `).join("");
}

async function approveWithdrawal(id){
 const r = await fetch(API+"/admin/withdrawals/"+id+"/approve",{method:"POST",headers:headers()});
 const j = await r.json();
 alert(j.ok ? "Retiro aprobado" : (j.error || "Error"));
 loadWithdrawals();
}

async function rejectWithdrawal(id){
 const r = await fetch(API+"/admin/withdrawals/"+id+"/reject",{method:"POST",headers:headers()});
 const j = await r.json();
 alert(j.ok ? "Retiro rechazado y saldo devuelto" : (j.error || "Error"));
 loadWithdrawals();
}

</script>

</body>
</html>
